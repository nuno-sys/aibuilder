{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    // `Env` is hand-authored in `src/env.ts` for the same reason as `apps/api`: a step or a handler
    // must be able to state which bindings it needs, and a generated global cannot be imported.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
