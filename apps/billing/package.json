{
  "name": "@aibuilder/billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The only Worker holding STRIPE_SECRET_KEY: the Stripe webhook, Checkout Session creation and the customer portal. One public route; everything else is reachable only over the BILLING service binding.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aibuilder/core": "workspace:*",
    "@aibuilder/db": "workspace:*",
    "stripe": "^22.6.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
