---
/**
 * The price block.
 *
 * The annual total, the VAT basis and what happens when the trial ends are shown at the same
 * visual weight as the headline rate, in the same block, above the fold of the section. That is a
 * legal requirement in this market, not a design preference: the Omnibus revision of the Unfair
 * Commercial Practices Directive (NL: Art. 6:193 BW) treats a monthly rate that is actually billed
 * annually, disclosed only in a footnote, as a misleading omission.
 *
 * There are no fabricated statistics, review counts or testimonials anywhere on this page. A
 * published marketing claim we cannot substantiate is a per-se unfair practice under UCPD Annex I,
 * and no amount of conversion lift is worth 4% of turnover.
 */
import CtaButton from './CtaButton.astro';
import { formatEuro, plan } from '../content/pricing';

interface Props {
  readonly id: string;
  readonly eyebrow: string;
  readonly title: string;
  readonly body: string;
  /** `h2` on the home page, `h1` on `/prijzen/` where pricing is the page's subject. */
  readonly headingLevel?: 'h1' | 'h2';
}

const { id, eyebrow, title, body, headingLevel = 'h2' } = Astro.props;

const monthly = formatEuro(plan.monthlyEur);
const annual = formatEuro(plan.annualTotalEur);
const today = formatEuro(0);

/**
 * The standard Dutch VAT rate, used only to render a worked example.
 *
 * The price is quoted excluding VAT because the target market is businesses
 * (`pricing.ts` → `vatIncluded: false`), and Stripe Tax computes the real figure from the customer's
 * country and VAT number at checkout. A consumer in the Netherlands nevertheless pays this, and
 * showing the number they will actually be charged is worth more than a sentence about a mechanism.
 */
const NL_VAT_RATE = 0.21;
const annualInclVat = formatEuro(Math.round(plan.annualTotalEur * (1 + NL_VAT_RATE) * 100) / 100);
---

<section class="section section--subtle pricing" id={id}>
  <div class="container">
    <div class="pricing__intro">
      <p class="eyebrow">{eyebrow}</p>
      {headingLevel === 'h1' ? <h1>{title}</h1> : <h2>{title}</h2>}
      <p class="lead">{body}</p>
    </div>

    <div class="pricing__card">
      <div class="pricing__headline">
        <p class="pricing__plan">{plan.name}</p>
        {/*
          TWO FIGURES, ONE SIZE. The headline rate and the amount that is actually charged sit side
          by side at identical weight, because the Omnibus revision of the UCPD treats a monthly rate
          billed annually — with the annual total demoted to smaller type or a footnote — as a
          misleading omission. `{annual}` is also literally what Stripe Checkout will render on the
          next screen, so the number the customer is promised is the number they see next.
        */}
        <div class="pricing__amounts">
          <p class="pricing__amount">
            <span class="pricing__amount-label">Per maand</span>
            <span class="pricing__figure tabular">{monthly}</span>
            <span class="pricing__unit">afgeleid tarief</span>
          </p>
          <p class="pricing__amount">
            <span class="pricing__amount-label">Wat er wordt afgeschreven</span>
            <span class="pricing__figure tabular">{annual}</span>
            <span class="pricing__unit">één keer per jaar, excl. btw</span>
          </p>
        </div>
        {/*
          The sentence a customer can check against their bank statement. It states what is charged
          today, what is charged later, when, and on what VAT basis.
        */}
        <p class="pricing__terms">
          Vandaag betaal je <strong class="tabular">{today}</strong>. De eerste {plan.trialDays}
          dagen zijn gratis; daarna wordt <strong class="tabular">{annual}</strong> exclusief btw in
          één keer voor twaalf maanden afgeschreven. Zeg je binnen {plan.trialDays} dagen op, dan
          betaal je niets. Een Nederlandse consument betaalt inclusief 21% btw {annualInclVat} per
          jaar; zakelijke klanten met een geldig btw-nummer rekenen de btw zelf af.
        </p>
      </div>

      <ul class="pricing__list">
        {
          plan.includes.map((item) => (
            <li class="pricing__item">
              <svg
                class="pricing__check"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m4 10.5 4 4 8-9" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="pricing__action">
        <CtaButton size="lg" block>{plan.trialDays} dagen gratis proberen</CtaButton>
        <p class="pricing__small">
          Je beantwoordt eerst zes vragen; daarna geef je een betaalmethode op bij Stripe en bouwen
          we je website. Tijdens de proefperiode van {plan.trialDays} dagen wordt er niets
          afgeschreven, en opzeggen doe je zelf in je account. Bekijk de
          <a href="/voorwaarden/">algemene voorwaarden</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing__intro {
    max-inline-size: var(--measure);
    margin-block-end: var(--space-12);
  }

  .pricing__intro .lead {
    margin-block-start: var(--space-4);
  }

  .pricing__card {
    display: grid;
    gap: var(--space-8);
    max-inline-size: 900px;
    padding: var(--space-8);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-page);
    box-shadow: var(--shadow-lg);
  }

  .pricing__plan {
    color: var(--fg-brand);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pricing__amounts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-5);
    margin-block-start: var(--space-4);
  }

  .pricing__amount {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .pricing__amount-label {
    color: var(--fg-tertiary);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pricing__figure {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--ls-5xl);
  }

  .pricing__unit {
    color: var(--fg-secondary);
    font-size: var(--text-sm);
  }

  .pricing__terms {
    max-inline-size: 62ch;
    margin-block-start: var(--space-5);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .pricing__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--border-subtle);
    padding-block: var(--space-6);
    list-style: none;
  }

  .pricing__item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: var(--space-3);
    align-items: start;
    color: var(--fg-secondary);
  }

  .pricing__check {
    margin-block-start: 3px;
    color: var(--success-600);
  }

  .pricing__action {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-inline-size: 480px;
  }

  .pricing__small {
    color: var(--fg-tertiary);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .pricing__card {
      padding: var(--space-10);
    }
  }
</style>
