---
/**
 * The document shell for every marketing page.
 *
 * `<head>` ORDER (SEO §4.12) — the preload scanner reads top-down and starts fetches before the
 * parser reaches them, so the only elements whose position actually costs milliseconds are the
 * ones that fetch:
 *
 *   1. LCP candidates: the art-directed hero poster preload and the one font file.
 *   2. Fonts: the two `@font-face` rules, inline, immediately after the preload that feeds them.
 *   3. Metadata: title, description, canonical, hreflang, icons, Open Graph. No fetches.
 *   4. JSON-LD.
 *
 * Astro appends its own hoisted `<style>` and module `<script>` tags just before `</head>`, so the
 * page CSS lands after (4). That costs nothing here: every stylesheet is INLINED
 * (`build.inlineStylesheets: 'always'`), so there is no render-blocking request whose discovery
 * could be delayed — the only reason the spec puts CSS second is to get an external sheet into the
 * first round trip, and we have no external sheet.
 */
import '../styles/tokens.css';
import '../styles/base.css';

import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExtUrl from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';

import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Nav from '../components/Nav.astro';
import OnboardingMount from '../components/OnboardingMount.astro';
import { heroPreloads } from '../content/hero-media';
import {
  brand,
  legalEntity,
  legalEntityIsConfigured,
  openGraphImage,
} from '../content/site';

/** One `hreflang` entry. Every member of a cluster must list every member, including itself. */
export interface Alternate {
  /** BCP 47 tag, or `x-default`. */
  readonly hreflang: string;
  /** Absolute URL on the canonical host, with a trailing slash. */
  readonly href: string;
}

interface Props {
  /** Page title without the brand; the brand suffix is appended here so it cannot drift. */
  readonly title: string;
  /** 150-160 characters, written for the SERP snippet, never truncated boilerplate. */
  readonly description: string;
  /** Emit the art-directed hero poster preloads. Only the page that renders `<Hero>` may set this. */
  readonly preloadHero?: boolean;
  /** `noindex, follow` — for pages that exist for humans but must not enter the index. */
  readonly noindex?: boolean;
  /**
   * Mount the onboarding island. Off on the legal pages: `client:idle` would download the whole
   * modal bundle for someone reading a privacy statement, whose CTA is a plain link to `/start/`.
   */
  readonly onboarding?: boolean;
  /** Extra nodes appended to the page's single `@graph`. */
  readonly graph?: readonly Readonly<Record<string, unknown>>[];
  /**
   * hreflang cluster. Phase 1 ships Dutch only, so pages pass nothing and no `alternate` links are
   * emitted — a single self-referencing entry is noise. Adding `/en/` is a data change here.
   */
  readonly alternates?: readonly Alternate[];
}

const {
  title,
  description,
  preloadHero = false,
  noindex = false,
  onboarding = true,
  graph = [],
  alternates = [],
} = Astro.props;

const site = Astro.site;
if (site === undefined) {
  throw new Error(
    'astro.config.mjs must set `site`: every canonical URL, hreflang entry and JSON-LD @id is ' +
      'derived from it, and emitting relative canonicals is an indexing bug that is invisible ' +
      'in development.',
  );
}

const canonical = new URL(Astro.url.pathname, site);
const documentTitle = `${title} · ${brand.name}`;
const ogImageUrl = new URL(openGraphImage.url, site);

/**
 * `Organization` and `WebSite` share one `@graph` with stable `@id`s, so every page refers to the
 * same two entities rather than minting duplicates (architecture §7.11). No `logo`: emitting an
 * `ImageObject` that 404s is worse than omitting an optional property, and the raster brand set is
 * delivered with the brand assets.
 */
const organizationId = `${site.origin}/#organization`;
const organization: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': organizationId,
  name: brand.name,
  url: site.origin,
  description: brand.description,
};

// Identity fields are added only when the operator has actually supplied them. A PostalAddress
// full of bracketed placeholders is structured misinformation.
if (legalEntityIsConfigured) {
  organization['legalName'] = legalEntity.legalName;
  organization['email'] = legalEntity.privacyEmail;
  organization['vatID'] = legalEntity.vatId;
  organization['address'] = {
    '@type': 'PostalAddress',
    streetAddress: legalEntity.streetAddress,
    postalCode: legalEntity.postalCode,
    addressLocality: legalEntity.city,
    addressCountry: legalEntity.country,
  };
}

const website: Record<string, unknown> = {
  '@type': 'WebSite',
  '@id': `${site.origin}/#website`,
  url: site.origin,
  name: brand.name,
  inLanguage: 'nl-NL',
  publisher: { '@id': organizationId },
  // No `potentialAction`/SearchAction: there is no site search, and claiming one that does not
  // exist is the single most common invalid-markup error on brochure sites.
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...graph],
};

/**
 * The two real faces. Their URLs are build-hashed, so these rules cannot live in the static
 * stylesheet — they are inlined here, right after the preload that feeds the latin subset.
 * `unicode-range` values are Fontsource's own subset definitions: `latin-ext` is what carries the
 * Dutch ĳ (U+0133) as well as German, French, Spanish and Portuguese diacritics, and it is fetched
 * only if a glyph in that range is actually used.
 */
const fontFaceCss = `
@font-face{font-family:'Inter Variable';src:url(${interLatinUrl}) format('woff2-variations');font-display:swap;font-style:normal;font-weight:100 900;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Inter Variable';src:url(${interLatinExtUrl}) format('woff2-variations');font-display:swap;font-style:normal;font-weight:100 900;unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}`.trim();
---

<!doctype html>
<html lang="nl" dir="ltr">
  <head>
    <meta charset="utf-8" />
    {/*
      `viewport-fit=cover` is required for `env(safe-area-inset-*)` on notched iPhones.
      `interactive-widget=resizes-content` is what makes the software keyboard shrink the layout
      viewport, so the modal's sticky footer button is not covered by it (UX §S6 `useKeyboardInset`).
      There is deliberately no `maximum-scale`/`user-scalable=no`: that is an automatic Lighthouse
      accessibility failure and a WCAG 1.4.4 violation.
    */}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />

    {/* 1. LCP candidates. Art-directed, so exactly one poster is fetched. */}
    {
      preloadHero &&
        heroPreloads.map((preload) => (
          <link
            rel="preload"
            as="image"
            type="image/avif"
            fetchpriority="high"
            media={preload.media}
            imagesrcset={preload.imagesrcset}
            imagesizes={preload.imagesizes}
          />
        ))
    }
    {/*
      `crossorigin` is MANDATORY on a font preload even same-origin: fonts are CORS-fetched, and
      omitting it makes the browser download the file twice. Only the latin subset is preloaded;
      latin-ext loads on demand and, because the fallback is metric-matched, its arrival shifts
      nothing.
    */}
    <link rel="preload" as="font" type="font/woff2" href={interLatinUrl} crossorigin />

    {/* 2. Fonts. */}
    <style is:inline set:html={fontFaceCss}></style>

    {/* 3. Metadata. */}
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }

    {/*
      SVG favicon only. The raster set (`favicon.ico`, `apple-touch-icon.png`) ships with the brand
      assets; referencing files that do not exist yet would trade a silent fallback for a 404 on
      every page load.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f1a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content={String(openGraphImage.width)} />
    <meta property="og:image:height" content={String(openGraphImage.height)} />
    <meta property="og:image:alt" content={openGraphImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* 4. JSON-LD. */}
    <JsonLd data={jsonLd} />
  </head>

  <body>
    <a class="skip-link" href="#hoofdinhoud">Naar de hoofdinhoud</a>
    <Nav overHero={preloadHero} />
    <main id="hoofdinhoud">
      <slot />
    </main>
    <Footer />
    {onboarding && <OnboardingMount />}
  </body>
</html>
