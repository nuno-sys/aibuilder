{
  "name": "@aibuilder/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The customer dashboard and live site editor: React Router v7 in framework mode on Workers, plus SiteDraftDO and the preview origin.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aibuilder/auth": "workspace:*",
    "@aibuilder/core": "workspace:*",
    "@aibuilder/db": "workspace:*",
    "@aibuilder/site-kit": "workspace:*",
    "@aibuilder/site-schema": "workspace:*",
    "@aibuilder/ui": "workspace:*",
    "isbot": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@react-router/dev": "^7.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
