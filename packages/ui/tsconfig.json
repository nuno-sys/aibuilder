{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    // The DOM lib, because this package IS the DOM layer. It is the one package that legitimately
    // needs it: everything else in `packages/` runs on workerd and takes its capabilities injected.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
