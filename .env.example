####################################################################################################
# aibuilder — operator environment (NON-SECRET)
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Nothing in this file is read by a deployed Worker. Worker configuration lives in each app's
# `wrangler.jsonc` (`vars` for plain values, `secrets_store_secrets` / `wrangler secret put` for
# secrets — see `.dev.vars.example`). This file exists so that the values you must paste into those
# `wrangler.jsonc` files, plus the resource ids the bootstrap prints, are written down in ONE place
# instead of being reconstructed from shell history.
####################################################################################################

# ── Wrangler CLI credentials ──────────────────────────────────────────────────────────────────────
# Only needed for non-interactive use (CI, scripted deploys). For local work `wrangler login` is
# enough and you should leave both blank.
# The API token needs: Workers Scripts:Edit, D1:Edit, Workers KV Storage:Edit, Workers R2 Storage:Edit,
# Queues:Edit, Workers Tail:Read, and Account Settings:Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── §S3 vars — the exact values that belong in each Worker's `wrangler.jsonc` `vars` block ────────
# `production` | `staging`. Gates `event.livemode` checks and log verbosity.   (all Workers)
ENVIRONMENT=staging

# The control-plane registrable domain. This is the EXACT string the API compares the request
# `Origin` header against — no regex, no suffix match. Changing it is a one-way door once tenant
# slugs are indexed (architecture §1.1, §10.4).                                (api)
APP_ORIGIN=https://www.example-control-plane.tld

# The tenant registrable domain. Generated sites are served at `<slug>.${SITES_ROOT_DOMAIN}`.
# Must NOT share a registrable domain with APP_ORIGIN.        (api, generator, renderer)
SITES_ROOT_DOMAIN=example-tenant-domain.tld

# Cookieless media origin, on the tenant domain.                       (renderer, generator)
MEDIA_ORIGIN=https://cdn.example-tenant-domain.tld

# R2 S3-compatible endpoint used for presigning uploads. The `.eu.` label is MANDATORY for
# jurisdictional buckets and is covered by the request signature, so signing the wrong host
# produces URLs that fail after the fact and cannot be repaired (architecture §1.3).      (api)
R2_S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

# Model id. Exactly this string — never append a date suffix (VERIFIED-FACTS).       (generator)
ANTHROPIC_MODEL=claude-opus-5

# ── Resource ids recorded during bootstrap (README > Bootstrap) ───────────────────────────────────
# These are not secrets; they are identifiers you must paste into the `wrangler.jsonc` of every app
# that binds the resource. Keep them here so a second operator can rebuild the configs.
D1_CP_DATABASE_ID=
D1_SHARD_000_DATABASE_ID=
KV_ROUTING_NAMESPACE_ID=
KV_GEO_NAMESPACE_ID=
SECRETS_STORE_ID=
